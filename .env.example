# ══════════════════════════════════════════════════════════════════════
#  AKILAS ARCHIVE — environment configuration
#  Copy to .env and fill in every value:   cp .env.example .env
#  Generate secrets with:                 openssl rand -hex 32
# ══════════════════════════════════════════════════════════════════════

# ── Cloudflare R2 (required) ────────────────────────────────────────────
# Dashboard → R2 → (right sidebar) "Account ID"
R2_ACCOUNT_ID=
# Dashboard → R2 → Manage API Tokens → Create API token
#   permissions: "Object Read & Write", scope: apply to all buckets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── one-time link signing (required) ───────────────────────────────────
# MUST be the SAME value as the worker's DOWNLOAD_SECRET secret
# (set on the worker with: npx wrangler secret put DOWNLOAD_SECRET)
DOWNLOAD_SECRET=

# ── admin session signing (required) ───────────────────────────────────
SESSION_SECRET=

# ── admin panel ─────────────────────────────────────────────────────────
# Initial admin password (only used on FIRST boot — afterwards the password
# lives in the database and this value is ignored). Generate one:
#   openssl rand -base64 18
ADMIN_PASSWORD=changeme123

# Set to 1 ONLY when you need to recover: overwrites the stored admin
# password with ADMIN_PASSWORD on next boot. Remove after logging in.
# ADMIN_PASSWORD_FORCE=1

# ── site ────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://akilasarchive.site

# Where one-time links redirect to. Use the worker's custom domain if you
# set one up (README step 3), otherwise your workers.dev URL:
#   https://akilas-archive-dl.<your-subdomain>.workers.dev
DOWNLOAD_BASE_URL=https://dl.akilasarchive.site

# ── download gateway mode ───────────────────────────────────────────────
# worker  = recommended — files stream from the Cloudflare edge, VPS
#           bandwidth stays at ~zero.
# presign = fallback — VPS app redirects to short-lived R2 presigned URLs
#           (the R2 endpoint becomes briefly visible in the address bar).
DL_MODE=worker

# ── tuning (sane defaults for a 512MB / 1 vCPU VPS) ─────────────────────
# How often buckets are re-indexed for search (hours; 0 = manual only)
INDEX_INTERVAL_HOURS=6
# Lifetime of a one-time link before it is redeemed (minutes, 1–60)
TOKEN_TTL_MINUTES=10
# Validity window after the link is redeemed (seconds)
DL_EXPIRY_SECONDS=300
